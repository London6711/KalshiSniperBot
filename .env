# ==============================================================================
# Kalshi Quant Meta-Agent & Autonomous V2 Stack - Environment Configuration
# ==============================================================================
# Save this file as `.env` in your working directory: ~/kalshi_workspace/.env
# Secure file permissions should be enforced via: chmod 600 .env
# ==============================================================================

# 1. Execution & Storage Settings
PYTHONUNBUFFERED=1
KALSHI_DB_FILE=/home/ubuntu/kalshi_workspace/trade_telemetry_v2.sqlite
KALSHI_EXPORT_DIR=/home/ubuntu/kalshi_workspace/exports
KALSHI_BACKUP_DIR=/home/ubuntu/kalshi_workspace/backups

# 2. Kalshi API Credentials (Production / Demo)
# Set your Kalshi Key ID and the absolute path to your RSA private key .pem file
KALSHI_KEY_ID=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=/home/ubuntu/.kalshi/private_key.pem
KALSHI_API_BASE=https://external-api.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# 3. Pyth Network Hermes v2 Endpoints
PYTH_HERMES_WS_URL=wss://hermes.pyth.network/ws
PYTH_HERMES_SSE_URL=https://hermes.pyth.network/v2/updates/price/stream

# 4. Telegram Remote Command Controller & Notifications
# Get your bot token from @BotFather and your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# 5. Blockchain & Cross-Exchange RPCs (Optional / Extended Feeds)
EVM_RPC_WSS=wss://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com